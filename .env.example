# Configuration Firebase (console Firebase → Paramètres du projet → Vos applications → Web).
# Copier ce fichier en .env et remplir. Laisser vide = app 100 % locale (aucune synchro).
# Après modification : relancer `npm start` (ou `npm run env` avant un déploiement).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
